# --- Supabase (free tier: Postgres + auth + storage + pgvector) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Models: routing lives in engine/providers/routing.ts, values here ---
# Gemini is primary. VERIFY is routed to a different family on purpose —
# assertVerifierIndependence() throws at startup if they match.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

MODEL_INGEST=
MODEL_GRAPH=
MODEL_DRAFT=
MODEL_TRANSLATE=
MODEL_TUTOR=
MODEL_TUTOR_FAMILY=gemini

MODEL_VERIFY=
MODEL_VERIFY_FAMILY=claude

# Open embedding model, self-run. Must match vector(N) in db/schema.sql.
MODEL_EMBED=bge-large-en-v1.5
EMBED_DIMENSIONS=1024

# Per-MTok prices for cost accounting. Fill from each provider's pricing page —
# cost-per-path in docs/05-economics.md is only as good as these numbers.
PRICE_INGEST_IN=
PRICE_INGEST_OUT=
PRICE_GRAPH_IN=
PRICE_GRAPH_OUT=
PRICE_DRAFT_IN=
PRICE_DRAFT_OUT=
PRICE_VERIFY_IN=
PRICE_VERIFY_OUT=

# --- Cloudflare R2 (10GB free, zero egress) for media + offline bundles ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=learnloop-content

# --- Optional, all free tiers ---
RESEND_API_KEY=
POSTHOG_KEY=
SENTRY_DSN=
STRIPE_SECRET_KEY=
