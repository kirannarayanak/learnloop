# --- Supabase (free tier: Postgres + auth + storage + pgvector) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local: docker compose up -d
# DATABASE_URL=postgres://postgres:learnloop@localhost:55432/learnloop
DATABASE_URL=

# --- Models: routing lives in engine/providers/routing.ts, values here ---
# Gemini is primary. VERIFY is routed to a different family on purpose —
# assertVerifierIndependence() throws at startup if they match.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Defaults are in engine/providers/routing.ts; set these only to override.
MODEL_INGEST=gemini-3.1-pro-preview
MODEL_GRAPH=gemini-3.1-pro-preview
MODEL_DRAFT=gemini-3.8-flash
MODEL_TRANSLATE=gemini-3.8-flash
MODEL_TUTOR=gemini-3.8-flash
MODEL_TUTOR_FAMILY=gemini

# Different family from MODEL_DRAFT on purpose — a model cannot verify its own output.
# assertVerifierIndependence() throws at startup if these match.
MODEL_VERIFY=claude-opus-5
MODEL_VERIFY_FAMILY=claude

# Open embedding model, self-run. Must match vector(N) in db/schema.sql.
MODEL_EMBED=bge-large-en-v1.5
EMBED_DIMENSIONS=1024

# Per-MTok prices for cost accounting. Fill from each provider's pricing page —
# cost-per-path in docs/05-economics.md is only as good as these numbers.
PRICE_INGEST_IN=2
PRICE_INGEST_OUT=12
PRICE_GRAPH_IN=2
PRICE_GRAPH_OUT=12
# VERIFY THESE — Flash pricing was a placeholder when written, not a quote.
PRICE_DRAFT_IN=0.3
PRICE_DRAFT_OUT=2.5
PRICE_VERIFY_IN=5
PRICE_VERIFY_OUT=25

# --- Cloudflare R2 (10GB free, zero egress) for media + offline bundles ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=learnloop-content

# --- Optional, all free tiers ---
RESEND_API_KEY=
POSTHOG_KEY=
SENTRY_DSN=
STRIPE_SECRET_KEY=
